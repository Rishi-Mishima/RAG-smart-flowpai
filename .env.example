# Copy this file to `.env` before running `docker compose up --build -d`.
# The defaults are for local development only. Change every password before
# exposing the application outside your machine.

COMPOSE_PROJECT_NAME=rag-smart-flowpai
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Published host ports
FRONTEND_PORT=8080
BACKEND_PORT=8081
MYSQL_PORT=3306
REDIS_PORT=6379
KAFKA_PORT=9092
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ELASTICSEARCH_PORT=9200

# Infrastructure credentials shared with the backend container
MYSQL_DATABASE=PaiSmart
SPRING_DATASOURCE_PASSWORD=PaiSmart2025
SPRING_DATA_REDIS_PASSWORD=PaiSmart2025
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=PaiSmart2025
MINIO_BUCKET_NAME=uploads
MINIO_PUBLIC_URL=http://localhost:9000
ELASTICSEARCH_PASSWORD=PaiSmart2025

# Must decode to 16, 24, or 32 bytes. Generate a new value with:
# openssl rand -base64 32
JWT_SECRET_KEY=XeJw0yUoFDJWSNbWYFVEIXGfO8XgHrQLrIkKci5J9eA=

# The first container start creates this administrator. Change the password.
# After the account exists, ADMIN_BOOTSTRAP_ENABLED can be set to false.
ADMIN_BOOTSTRAP_ENABLED=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=change-this-admin-password
ADMIN_BOOTSTRAP_PRIMARY_ORG=default
ADMIN_BOOTSTRAP_ORG_TAGS=default,admin

APP_AUTH_REGISTRATION_MODE=INVITE_ONLY
APP_AUTH_INVITE_REQUIRED=true
SECURITY_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Keep this false until EMBEDDING_API_KEY is configured. When enabled, the
# backend imports docs/paismart.pdf during startup.
KNOWLEDGE_BOOTSTRAP_ENABLED=false

DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_API_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
EMBEDDING_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_MODEL=text-embedding-v4
EMBEDDING_API_KEY=

KAFKA_ADVERTISED_HOST=localhost
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g
JAVA_TOOL_OPTIONS=-Xms256m -Xmx1g
LOG_LEVEL_APP=INFO

# Optional WeChat Pay configuration
WX_PAY_ENABLE=false
WX_PAY_APP_ID=
WX_PAY_MERCHANT_ID=
WX_PAY_PRIVATE_KEY=
WX_PAY_MERCHANT_SERIAL_NUMBER=
WX_PAY_API_V3_KEY=
WX_PAY_NOTIFY_URL=https://smart.paicoding.com/api/v1/recharge/pay-callback
WX_PAY_REFUND_NOTIFY_URL=https://smart.paicoding.com/api/v1/recharge/refund-callback
